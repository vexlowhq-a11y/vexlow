# admin/ ya está excluido arriba (cubre admin/ops-log.jsonl); estos son los
# que quedan fuera de admin/.
data/backups/
data/trash.json
_trash/

# Caché técnica de "Buscar noticias nuevas" (pedido de Leonardo, 2026-09-23,
